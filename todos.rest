
@baseUrl = http://localhost:3000

### 1. Create a Todo
# @name createTodo
POST {{baseUrl}}/todos
Content-Type: application/json

{
    "title": "Complete Assignment 5 test",
    "description": "Test 2 Refactor and test the REST API",
    "state": "todo"
}

### 2. Retrieve all Todos
GET {{baseUrl}}/todos

### 3. Retrieve one Todo by ID
GET {{baseUrl}}/todos/{{createTodo.response.body.$.id}}

### 4. Update Todo state
PUT {{baseUrl}}/todos/{{createTodo.response.body.$.id}}
Content-Type: application/json

{
    "state": "doing"
}

### 5. Retrieve Todos with state doing
GET {{baseUrl}}/todos?state=doing

### 6. Delete the Todo
DELETE {{baseUrl}}/todos/{{createTodo.response.body.$.id}}

### 7. Verify that the Todo was deleted
GET {{baseUrl}}/todos/{{createTodo.response.body.$.id}}


### Create a completed Todo
POST http://localhost:3000/todos
Content-Type: application/json

{
    "title": "Complete Assignment 6",
    "description": "Test CSV response",
    "state": "done"
}


### GET all Todos in JSON format
GET http://localhost:3000/todos
Accept: application/json

### GET all Todos in CSV format
GET http://localhost:3000/todos
Accept: text/csv

### GET Todos with state done in CSV format
GET http://localhost:3000/todos?state=done
Accept: text/csv

### GET Todos with unsupported response format
GET http://localhost:3000/todos
Accept: application/xml
